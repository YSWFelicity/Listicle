# Copy this file to .env at the project root. Never commit real credentials.
# Web server port (independent of PostgreSQL's port).
PORT=3000

# Use the Render database's EXTERNAL connection settings for local development.
# Copy the complete external hostname; do not guess a regional suffix.
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=

# External Render connection: verify-full. Local PostgreSQL without TLS: disable.
PGSSLMODE=verify-full
